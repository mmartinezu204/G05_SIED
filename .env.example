# Host del workspace, tal cual aparece en la URL del navegador, SIN "https://"
# (ej. dbc-xxxxxxxx-xxxx.cloud.databricks.com)
DATABRICKS_HOST=

# Icono de usuario -> Settings -> Developer -> Access tokens -> Manage -> Generate new token
# Databricks solo lo muestra una vez al generarlo.
DATABRICKS_TOKEN=

# SQL Warehouses -> seleccionar el warehouse -> pestaña "Connection details" -> campo "HTTP path"
# (formato /sql/1.0/warehouses/<id>)
DATABRICKS_HTTP_PATH=
